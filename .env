# Environment Variables
NODE_ENV=development
PORT=3000

# Discord OAuth
DISCORD_CLIENT_ID=1432113571176906954
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback
DISCORD_REQUIRED_GUILD_ID=1153027935553454191
DISCORD_BOT_TOKEN=your_discord_bot_token

# Google OAuth (fill these when you create Google app)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# JWT Secret (change this to a random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Session Secret (change this to a random string)
SESSION_SECRET=your_super_secret_session_key_change_this_in_production

# MongoDB Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/heartbrokenskins?retryWrites=true&w=majority

# Frontend URL
FRONTEND_URL=http://localhost:8000
